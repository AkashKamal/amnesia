# LF everywhere. The corpus is compared byte-for-byte against generator output
# in CI; a CRLF checkout on a contributor's machine would fail that silently.
* text=auto eol=lf

*.tsv text eol=lf
*.go  text eol=lf

# Generated by tools/corpus-gen. Collapse it in diffs and keep it out of the
# language stats - it is data, not source.
internal/corpus/data/commands.tsv linguist-generated=true
